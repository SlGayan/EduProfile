DATABASE_URL=postgresql://user:password@localhost:5432/eduprofile
APP_JWT_SECRET=changeme
BCRYPT_SALT_ROUNDS=10
JWT_EXPIRES_IN=15m
MAX_MATERIAL_UPLOAD_MB=10
# No key/secret here by design (AD-2): the API authenticates to Blob Storage
# via Managed Identity (DefaultAzureCredential). Locally, DefaultAzureCredential
# falls back to your own `az login` session -- run `az login` and make sure
# your account has the Storage Blob Data Contributor role on the account below.
AZURE_STORAGE_ACCOUNT_NAME=eduprofilematerials
AZURE_STORAGE_CONTAINER_NAME=study-materials
