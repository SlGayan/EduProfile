// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  PRINCIPAL
  ADMINISTRATOR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  mustChangePassword Boolean @default(false)
  student   Student?
  teacher   Teacher?
  issuedCertificates CharacterCertificate[]
}

model Student {
  id          Int        @id @default(autoincrement())
  userId      Int        @unique
  user        User       @relation(fields: [userId], references: [id])
  fullName    String
  indexNumber String     @unique
  dateOfBirth DateTime
  address     String
  nicNumber   String?    @unique
  olYear      Int?
  alYear      Int?
  admissionNumber String? @unique
  dateOfAdmission DateTime?
  admissionGrade  String?
  attendancePercentage Float?
  classes     Class[]
  termMarks   TermMark[]
  activities  ExtracurricularActivity[]
  certificates CharacterCertificate[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Teacher {
  id             Int             @id @default(autoincrement())
  userId         Int             @unique
  user           User            @relation(fields: [userId], references: [id])
  classes        Class[]
  studyMaterials StudyMaterial[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Class {
  id             Int             @id @default(autoincrement())
  name           String
  year           Int?
  teacherId      Int?
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  students       Student[]
  studyMaterials StudyMaterial[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Subject {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  termMarks      TermMark[]
  studyMaterials StudyMaterial[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TermMark {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  term      Int
  year      Int
  marks     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, term, year])
  @@index([studentId])
  @@index([subjectId])
}

enum ActivityStatus {
  PENDING
  APPROVED
  NEEDS_CORRECTION
  REJECTED
}
model ExtracurricularActivity {
  id           Int       @id @default(autoincrement())
  studentId    Int
  student      Student   @relation(fields: [studentId], references: [id])
  activityName String
  activityType String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  achievements String?
  evidenceUrl  String?
  status       ActivityStatus @default(PENDING)
  teacherNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
}

model StudyMaterial {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  fileUrl      String
  fileType     String
  uploadedById Int
  uploadedBy   Teacher  @relation(fields: [uploadedById], references: [id])
  classId      Int?
  class        Class?   @relation(fields: [classId], references: [id])
  subjectId    Int?
  subject      Subject? @relation(fields: [subjectId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([classId])
  @@index([subjectId])
}

enum CharacterGrade {
  GOOD
  VERY_GOOD
  EXCELLENT
}

model CharacterCertificate {
  id               String   @id // Format: DSCTH/CC/YYYY/NNNN
  studentId        Int
  student          Student  @relation(fields: [studentId], references: [id])
  principalId      Int
  principal        User     @relation(fields: [principalId], references: [id])
  selectedActivities String[]
  reasonForLeaving String?
  characterGrade   CharacterGrade?
  studentAttributes String?
  academicSummary  String?
  issuedAt         DateTime @default(now())
  contentSnapshot  Json

  @@index([studentId])
  @@index([principalId])
}
