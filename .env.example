# Docker Compose environment variables
# Copy this file to .env and fill in the values before running docker-compose up

# Postgres credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=eduprofile

# API secrets
JWT_SECRET=changeme-use-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Public-facing API URL (browser-accessible). 
# For local Docker staging, leave as localhost:3000 (proxied through Next.js).
# For Azure, set to your API App Service URL e.g. https://eduprofile-api-xxx.azurewebsites.net
NEXT_PUBLIC_API_URL=http://localhost:3000
